# dash-nodes Tor client, plus the control port the dashds create their onion services through
# (dashd -torcontrol). Both ports are only reachable on the compose network (neither is published);
# SocksPolicy limits SOCKS to private ranges besides, and the control port takes the password
# entrypoint.sh passes in (HashedControlPassword).
SocksPort 0.0.0.0:9050 ExtendedErrors
SocksPolicy accept 127.0.0.0/8
SocksPolicy accept 10.0.0.0/8
SocksPolicy accept 172.16.0.0/12
SocksPolicy accept 192.168.0.0/16
SocksPolicy reject *
# Client only: never a relay, exit or directory mirror.
ClientOnly 1
ORPort 0
DirPort 0
ExitRelay 0
ExitPolicy reject *:*
ControlPort 0.0.0.0:9051
DataDirectory /var/lib/tor
AvoidDiskWrites 1
Log notice stdout
