# This vantage's id ([a-z0-9-]{2,16}): its results go to v1/{net}/bench/{VANTAGE}/.
VANTAGE=nyc
# Where it is, for people.
VANTAGE_LOCATION=DigitalOcean NYC3, US East
# The image to run (built from this repo, see README.md).
BENCH_IMAGE=dash-nodes:local
# Targets and reference hashes; results go to TARGET's /_ingest.
SOURCE=https://nodes.dashhq.org
TARGET=https://nodes.dashhq.org
NETWORKS=mainnet testnet
CYCLE_DAYS=14
BENCH_CONCURRENCY=2
# Don't start tests while running ones download more than this (megabits/s).
BENCH_MAX_MBIT=24
CRAWL_IPV6=auto
RUST_LOG=info
