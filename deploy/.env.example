# dashd image tag for both networks.
DASHD_TAG=24.0.0-rc.4
MAINNET_DBCACHE_MB=1536
TESTNET_DBCACHE_MB=512
# Seconds between crawl starts, and parallel handshakes per crawl.
CRAWL_INTERVAL=900
CRAWL_CONCURRENCY=128
# Where the app's own site and API listen on the host (LAN only; the public site is the Worker).
HTTP_BIND=0.0.0.0
HTTP_PORT=8080
# Where the publisher sends documents (the Worker's origin).
PUBLISH_TARGET=https://nodes.dashhq.org
# Parallel handshakes through Tor and I2P (they're slow; don't flood them).
TOR_CONCURRENCY=16
I2P_CONCURRENCY=8
# IPv6: auto crawls it if the app reaches the IPv6 internet (directly or through NAT66); or set a SOCKS5 proxy for it.
CRAWL_IPV6=auto
IPV6_PROXY=
# CJDNS: set to true together with the `cjdns` profile (needs /dev/net/tun on the host).
CJDNS=false
# Profiles: `cjdns` runs the cjdns node.
COMPOSE_PROFILES=
RUST_LOG=info
# Masternode speed tests (the `bench` service): this vantage's id ([a-z0-9-]{2,16}; its results are
# published under it) and where it is, for people; one pass over the network per BENCH_CYCLE_DAYS,
# tests at once, networks. Its token goes in secrets/bench_token.
BENCH_VANTAGE=local
BENCH_LOCATION=
BENCH_CYCLE_DAYS=14
BENCH_CONCURRENCY=2
BENCH_NETWORKS=mainnet testnet
