# dashd image tag for both networks.
DASHD_TAG=24.0.0-rc.4
MAINNET_DBCACHE_MB=1536
TESTNET_DBCACHE_MB=512
# Seconds between crawl starts, and parallel handshakes per crawl.
CRAWL_INTERVAL=900
CRAWL_CONCURRENCY=128
# Where the web app listens on the host.
HTTP_BIND=0.0.0.0
HTTP_PORT=8080
# Set to `tunnel` to run cloudflared (put the token in secrets/cloudflare_tunnel_token).
COMPOSE_PROFILES=
RUST_LOG=info
