# dashd image tag for both networks.
DASHD_TAG=24.0.0-rc.4
MAINNET_DBCACHE_MB=1536
TESTNET_DBCACHE_MB=512
# Seconds between crawl starts, and parallel handshakes per crawl.
CRAWL_INTERVAL=900
CRAWL_CONCURRENCY=128
# Where the web app listens on the host.
HTTP_BIND=0.0.0.0
HTTP_PORT=8080
# Parallel handshakes through Tor and I2P (they're slow; don't flood them).
TOR_CONCURRENCY=16
I2P_CONCURRENCY=8
# IPv6: auto crawls it if the app has a global IPv6 route; or set a SOCKS5 proxy for it.
CRAWL_IPV6=auto
IPV6_PROXY=
# CJDNS: set to true together with the `cjdns` profile (needs /dev/net/tun on the host).
CJDNS=false
# Profiles: `tunnel` runs cloudflared (token in secrets/cloudflare_tunnel_token), `cjdns` the cjdns
# node; comma-separated.
COMPOSE_PROFILES=
RUST_LOG=info
