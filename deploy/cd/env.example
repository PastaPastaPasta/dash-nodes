# /etc/dash-nodes-cd/env: this host's settings for dash-nodes-update (deploy/cd/update.sh), which
# sources it. Defaults are in update.sh.
REPO_URL=https://github.com/PastaPastaPasta/dash-nodes.git
BRANCH=main
APP_DIR=/opt/dash-nodes
# The app's port on this host (HTTP_BIND and HTTP_PORT in deploy/.env).
HEALTH_URL=http://127.0.0.1:8080/healthz
# The site the Worker serves; its Worker deploy waits until these summaries come from the new app.
PUBLIC_URL=https://nodes.dashhq.org
NETWORKS="mainnet testnet"
# Services `docker compose up -d` starts after a build; empty means all of them.
SERVICES=
# The Worker deploy needs a Cloudflare API token in CF_TOKEN_FILE (default /etc/dash-nodes-cd/cf-token,
# mode 0600) that can edit Workers scripts, and the account id if the token can't list memberships.
# Without a token the Worker isn't deployed (each pass says so).
CLOUDFLARE_ACCOUNT_ID=
